rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rebostCodes/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && code.size() == 6
        && request.resource.data.id is string
        && request.resource.data.name is string;
      allow delete: if request.auth != null
        && resource.data.id is string
        && get(/databases/$(database)/documents/rebosts/$(resource.data.id)).data.owner == request.auth.uid;
      allow update: if false;
    }
    match /rebosts/{id} {
      allow read: if request.auth != null && (
        resource.data.owner == request.auth.uid ||
        ('members' in resource.data && resource.data.members.hasAny([request.auth.uid]))
      );
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members.hasAny([request.auth.uid]);
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.owner == request.auth.uid
        || (
          'members' in resource.data
          && resource.data.members.hasAny([request.auth.uid])
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['name', 'owner', 'code'])
        )
        || (
          request.resource.data.members.hasAny([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        )
      );
    }
  }
}
